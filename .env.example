# Supabase Configuration
# Configure estas variáveis para conectar ao Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Kyro Clean Solutions — servidor local (projeto kyro-clean-solutions, `bun run serve`)
# Só é alcançável a correr localmente (não em produção/Cloudflare). Usado pelo
# admin panel (tab WhatsApp) para mostrar estado da ligação + QR code.
VITE_KYRO_LOCAL_URL=http://localhost:3010

# reCAPTCHA v3 (proteção contra spam no pedido de orçamento)
# A chave do SITE vai no build (é pública) e tem de estar no Cloudflare Pages.
# A chave SECRETA fica só nos segredos das Edge Functions do Supabase, como
# RECAPTCHA_SECRET_KEY (nunca aqui). Ver docs/lead-spam-protection.md.
VITE_RECAPTCHA_SITE_KEY=

# Resend Configuration (Backend Only - Configure no Supabase Dashboard)
# 1. Crie uma conta em https://resend.com (gratuito - 3,000 emails/mês)
# 2. Valide o seu domínio (opcional): https://resend.com/domains
# 3. Crie uma API key: https://resend.com/api-keys
# 4. Adicione a API key como secret no Supabase:
#    - Vá para: Project Settings > Edge Functions > Secrets
#    - Adicione: RESEND_API_KEY = sua_api_key_aqui
#
# Nota: A API key do Resend fica APENAS no backend (seguro)
#
# Usada pela função send-lead-email (pedidos de orçamento e contacto, substitui
# o Formspree). Precisa também de uma segunda secret no mesmo sítio:
#    - Adicione: LEAD_NOTIFICATION_EMAIL = endereço que deve receber os pedidos

# MailerLite Configuration (Backend Only - Configure no Supabase Dashboard)
# 1. Crie uma conta em https://www.mailerlite.com (gratuito - 1,000 subscribers)
# 2. Obtenha a sua API key:
#    - Vá para: Integrations > Developer API
#    - Copie a API key
# 3. Adicione a API key como secret no Supabase:
#    - Vá para: Project Settings > Edge Functions > Secrets
#    - Adicione: MAILERLITE_API_KEY = sua_api_key_aqui
# 4. (Opcional) Crie grupos no MailerLite para organizar subscribers:
#    - Vá para: Subscribers > Groups
#    - Guarde o ID do grupo para usar na subscrição
#
# Nota: A API key do MailerLite fica APENAS no backend (seguro)

# ── Medição: Google Analytics 4 e Google Ads ─────────────────────────────────
#
# Nada aqui é segredo. Um Measurement ID e um Conversion ID são públicos por
# construção: vão no HTML de qualquer site que os use. Estão em variáveis de
# ambiente para poderem ser trocados sem um deploy de código — foi por estarem
# escritos à mão dentro de src/lib/consent.ts que o ID de uma conta de Google
# Ads desativada continuou configurado durante meses.
#
# Estas variáveis têm de ser configuradas no Cloudflare Pages
# (Settings → Environment variables). O .env local NÃO chega ao build de
# produção — ver a quinta armadilha no CLAUDE.md.
#
# Sem nenhuma delas configurada o site funciona na mesma, com os valores por
# omissão que estão em src/constants/tracking.ts.

# Propriedade GA4 (por omissão: G-T45T5FBNC3)
VITE_GA4_MEASUREMENT_ID=G-T45T5FBNC3

# Google Ads da conta de 2026 (por omissão: AW-18457115875)
VITE_GOOGLE_ADS_ID=AW-18457115875

# O "Google Tag" (GT-) que a Google cria para a propriedade GA4.
# NÃO é carregado como segundo script: o GT- e o G- da mesma propriedade são o
# mesmo contentor com dois nomes, e carregar os dois duplicava cada page_view.
# Está aqui porque é o identificador que aparece na interface da Google.
VITE_GOOGLE_TAG_ID=GT-M6XTKMC7

# ── Conversões do Google Ads ─────────────────────────────────────────────────
#
# WEBSITE e OFFLINE são caminhos diferentes e NÃO usam o mesmo tipo de valor.
#
# Website: uma ETIQUETA (a parte depois da barra em AW-18457115875/AbC-D_efGhIj),
# usada no `send_to` de um gtag('event','conversion',…).
VITE_GOOGLE_ADS_LEAD_CONVERSION_LABEL=
#
# Offline: o NOME da ação de conversão, escrito exatamente como está no Google
# Ads. Uma importação offline não usa `send_to` nem etiqueta nenhuma — usa o
# nome da ação mais o identificador de clique. Pôr aqui uma etiqueta produz um
# ficheiro que o Google Ads rejeita, ou pior, aceita e não atribui a nada.
VITE_GOOGLE_ADS_QUALIFIED_LEAD_ACTION=
VITE_GOOGLE_ADS_CUSTOMER_CONVERSION_ACTION=
#
# Todas deliberadamente SEM valor por omissão: um valor inventado envia
# conversões para o vazio e parece que funciona. Sem eles, o lead é registado na
# mesma com a atribuição toda, e o painel avisa que falta.

# ── Enhanced Conversions for Leads ───────────────────────────────────────────
#
# 'true' liga o envio de email/telefone com hash SHA-256 pelo canal user_data.
# Desligado por omissão: ligar isto é uma decisão com implicações de proteção de
# dados (a política de privacidade tem de o dizer) e a ação de conversão tem de
# ter enhanced conversions ligado do lado do Google Ads, senão não faz nada.
VITE_ENHANCED_CONVERSIONS=false

# ── Modo de consentimento ────────────────────────────────────────────────────
#
# 'advanced' (omissão, decisão do dono a 2026-09-26) — a gtag.js carrega sempre,
#            com os quatro sinais a 'denied'. Nesse estado a Google não escreve
#            cookies nem guarda identificadores; envia pings sem cookies que
#            alimentam a modelação de conversões. A política de privacidade
#            descreve este modo.
# 'basic'    — a gtag.js só carrega depois de a pessoa aceitar. Quem recusa, ou
#            ainda não decidiu, não gera pedido nenhum para a Google. Mudar para
#            'basic' obriga a reescrever também a política de privacidade.
# Deixar vazio para usar a omissão. Não copiar 'basic' para o Cloudflare Pages.
VITE_CONSENT_MODE=

# ── Ambiente de medição ──────────────────────────────────────────────────────
#
# Fora de produção (localhost, previews, *.pages.dev) o site NÃO envia nada para
# a Google. `?kyro_debug=1` só escreve no console — não autoriza envio nenhum.
#
# Para testar o envio a sério são precisas DUAS coisas ao mesmo tempo:
#   1. esta variável a 'true';
#   2. identificadores que NÃO sejam os de produção (ver acima).
#
# A segunda condição é a que importa: mesmo com isto ligado por engano, não se
# envia enquanto o VITE_GA4_MEASUREMENT_ID for o real. Em produção deixar vazio.
VITE_TRACKING_ALLOW_NON_PRODUCTION=false
